# Copy to ~/tims-hockey/secrets/tims.env and chmod 600.
# That path is outside the git checkout and outside public_html.
# Point the daily job at it with TIMS_ENV. Never commit the filled-in file.
#
# The picks GET is not wired yet (see job/groups.py). Until it is, run the
# job with --groups and leave these blank. When the fetcher lands it will
# read one of these. Values are never written to the publish directory or the log.

TIMS_BEARER=
TIMS_COOKIE=
