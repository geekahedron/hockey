# Copy to ~/tims-hockey/secrets/tims.env and chmod 600.
# That path is outside the git checkout and outside public_html.
# Point the daily job at it with TIMS_ENV. Never commit the filled-in file.
#
# The job mints a Cognito IdToken with REFRESH_TOKEN_AUTH and reads the
# three pick groups with the HockeyPlayers query. If Cognito returns a new
# refresh token, it is written back to this file. A rejected token stops
# the run and leaves the published JSON in place. There is no magic-link
# sign-in here.

TIMS_CLIENT_ID=
TIMS_USER_POOL_ID=
TIMS_COGNITO_ID=
TIMS_REFRESH_TOKEN=
TIMS_USER_AGENT=
